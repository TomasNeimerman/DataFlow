{
  "name": "dataflow",
  "version": "0.1.0",
  "private": true,
  "author": "Bejerman",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "electrondev": "npm-run-all -p dev electron",
    "electron-build": "electron-builder .",
    "build:web": "next build",
    "dist": "npm run build:web && electron-builder --win=portable"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "electron-packager": "^17.1.2",
    "electron-store": "^10.1.0",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "mysql2": "^3.14.1",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.5.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "npm-run-all": "^4.1.5"
  },
  "build": {
    "appId": "com.bejermanErp.updater",
    "productName": "DataFlow",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "public/iconodesktop.ico"
    },
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "package.json",
      "public/**/*",
      "templates/**/*",
      "app/**/*",
      "node_modules/**/*",
      "eslint.config.mjs",
      "next.config.mjs",
      "jsconfig.json",
      "package-lock.json"
    ],
    "extraResources": [
      {
        "from": "electron/fileConfigUpdater",
        "to": "fileConfigUpdater"
      }
    ],
    "nsis": {
      "include": "electron/build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "installerIcon": "public/iconodesktop.ico",
      "uninstallerIcon": "public/iconodesktop.ico",
      "license": "public/license.txt"
    }
  }
}
