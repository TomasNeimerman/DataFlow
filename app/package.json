{
  "name": "dataflow",
  "version": "0.3.0",
  "description": "DataFlow",
  "private": true,
  "author": "Consultora de Negocios Empresrios S.R.L.",
  "main": "electron/main.js",
  "engines": {
    "node": "16.20.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "electrondev": "npm-run-all -p dev electron",
    "electron-build": "npm run build:web && electron-builder",
    "build:web": "next build",
    "clear:store:local": "electron ./electron/helpers/clear-store.js",
    "dist": "npm run build:web && electron-builder --win",
    "clean": "node electron/helpers/clean.js",
    "dist:fresh": "npm run clear:store:local && electron-builder --win",
    "dist:fresh:bound": "npm run clear:store:local && cross-env APP_RESET_POLICY=BOUND_ONLY electron-builder --win",
    "dist:fresh:full": "npm run clear:store:local && cross-env APP_RESET_POLICY=FULL electron-builder --win",
    "dist:run:reset-store": "dist\\win-unpacked\\<TuApp>.exe --reset-store",
    "dist:run:reset-bound": "dist\\win-unpacked\\<TuApp>.exe --reset-bound"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^7.0.3",
    "jsonwebtoken": "^8.5.1",
    "mssql": "^7.3.0",
    "mysql2": "^2.3.3",
    "next": "^12.3.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rimraf": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^13.6.9",
    "electron-builder": "^23.6.0",
    "electron-packager": "^17.1.2",
    "npm-run-all": "^4.1.5"
  },
  "build": {
    "appId": "com.DataFlow.updater",
    "productName": "DataFlow",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "DataFlow ${version}",
      "buildResources": "electron/build"
    },
    "extraResources": [
      {
        "from": "public/templates",
        "to": "templates"
      }
    ],
    "files": [
      "electron/**/*",
      ".next/**/*",
      "package.json",
      "public/**/*",
      "templates/**/*",
      "app/**/*",
      "node_modules/**/*",
      "fileConfigUpdater/**/*",
      "eslint.config.mjs",
      "next.config.mjs",
      "jsconfig.json",
      "package-lock.json",
      "styles/**/*"
    ],
    "electronVersion": "13.6.9",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/iconodesktop.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "include": "electron/build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "installerIcon": "public/iconodesktop.ico",
      "uninstallerIcon": "public/iconodesktop.ico",
      "license": "public/license.txt"
    }
  }
}
