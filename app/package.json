{
  "name": "dataflow",
  "version": "0.1.0",
  "private": true,
  "author": "Bejerman",
  "main": "electron/main.js",
  "engines": {
    "node": "16.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "electrondev": "npm-run-all -p dev electron",
    "electron-build": "npm run build:web && electron-builder",
    "build:web": "next build",
    "dist": "npm run build:web && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^7.0.3",
    "jsonwebtoken": "^8.5.1",
    "mssql": "^7.3.0",
    "mysql2": "^2.3.3",
    "next": "^12.3.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^13.6.9",
    "electron-builder": "^23.6.0",
    "electron-packager": "^17.1.2",
    "npm-run-all": "^4.1.5"
  },
  "build": {
    "appId": "com.DataFlow.updater",
    "productName": "DataFlow",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "package.json",
      "public/**/*",
      "templates/**/*",
      "app/**/*",
      "node_modules/**/*",
      "fileConfigUpdater/**/*",
      "eslint.config.mjs",
      "next.config.mjs",
      "jsconfig.json",
      "package-lock.json",
      "styles/**/*"
    ],
    "electronVersion": "13.6.9",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "public/iconodesktop.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "include": "electron/build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "installerIcon": "public/iconodesktop.ico",
      "uninstallerIcon": "public/iconodesktop.ico",
      "license": "public/license.txt"
    }
  }
}
